{
  "name": "read-aloud-text-to-speech-tts",
  "displayName": "Read Aloud: Offline Text to Speech (TTS) & PDF Reader",
  "description": "Turn your VS Code into an offline neural voice reader. 100% private text-to-speech for PDF, Markdown, and Code with natural voices, zero API keys, and Cosmo alien companion.",
  "version": "1.0.3",
  "publisher": "codewithgod",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0a0e1a",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dragonwinner/Read-Aloud-Offline-Text-to-Speech-TTS-PDF-Reader.git"
  },
  "bugs": {
    "url": "https://github.com/Dragonwinner/Read-Aloud-Offline-Text-to-Speech-TTS-PDF-Reader/issues"
  },
  "homepage": "https://github.com/Dragonwinner/Read-Aloud-Offline-Text-to-Speech-TTS-PDF-Reader#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other",
    "Education"
  ],
  "keywords": [
    "read aloud",
    "text to speech",
    "tts",
    "speech",
    "voice reader",
    "pdf reader",
    "offline tts",
    "audio reader",
    "screen reader",
    "markdown reader",
    "neural voice",
    "piper tts",
    "accessibility"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:alishaVoice.readSelection",
    "onCommand:alishaVoice.readFromCursor",
    "onCommand:alishaVoice.readFile",
    "onCommand:alishaVoice.pauseResume",
    "onCommand:alishaVoice.stop",
    "onCommand:alishaVoice.toggleVoice",
    "onCommand:alishaVoice.toggleAutoReadOnCopy",
    "onCommand:alishaVoice.toggleAlienPet",
    "onCommand:alishaVoice.setSpeed",
    "onCommand:alishaVoice.showMenu",
    "onCommand:alishaVoice.setupModels",
    "onView:alishaVoice.sidebarView",
    "onLanguage:markdown",
    "onLanguage:plaintext",
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "alisha-companion",
          "title": "Read Aloud & Cosmo",
          "icon": "media/alien-icon.png"
        }
      ]
    },
    "views": {
      "alisha-companion": [
        {
          "type": "webview",
          "id": "alishaVoice.sidebarView",
          "name": "Cosmo Space Companion"
        }
      ]
    },
    "commands": [
      {
        "command": "alishaVoice.readSelection",
        "title": "Read Selected Text",
        "category": "Cosmo Voice",
        "icon": "$(play)"
      },
      {
        "command": "alishaVoice.readFromCursor",
        "title": "Read From Cursor",
        "category": "Cosmo Voice",
        "icon": "$(play)"
      },
      {
        "command": "alishaVoice.readFile",
        "title": "Read Entire File",
        "category": "Cosmo Voice",
        "icon": "$(book)"
      },
      {
        "command": "alishaVoice.pauseResume",
        "title": "Pause / Resume",
        "category": "Cosmo Voice",
        "icon": "$(debug-pause)"
      },
      {
        "command": "alishaVoice.stop",
        "title": "Stop Playback",
        "category": "Cosmo Voice",
        "icon": "$(debug-stop)"
      },
      {
        "command": "alishaVoice.toggleVoice",
        "title": "Switch Voice (Male / Female)",
        "category": "Cosmo Voice",
        "icon": "$(account)"
      },
      {
        "command": "alishaVoice.toggleAutoReadOnCopy",
        "title": "Toggle Auto-Read on Copy (PDF Mode)",
        "category": "Cosmo Voice",
        "icon": "$(megaphone)"
      },
      {
        "command": "alishaVoice.toggleAlienPet",
        "title": "Open Cosmo Alien Companion",
        "category": "Cosmo Voice",
        "icon": "$(heart)"
      },
      {
        "command": "alishaVoice.setSpeed",
        "title": "Set Playback Speed (0.5x to 2.0x)",
        "category": "Cosmo Voice",
        "icon": "$(dashboard)"
      },
      {
        "command": "alishaVoice.showMenu",
        "title": "Cosmo: Quick Actions Menu",
        "category": "Cosmo Voice"
      },
      {
        "command": "alishaVoice.setupModels",
        "title": "Setup / Verify Offline Voice Models",
        "category": "Cosmo Voice"
      }
    ],
    "keybindings": [
      {
        "command": "alishaVoice.readSelection",
        "key": "alt+r",
        "mac": "cmd+alt+r"
      },
      {
        "command": "alishaVoice.toggleAutoReadOnCopy",
        "key": "alt+c",
        "mac": "cmd+alt+c"
      },
      {
        "command": "alishaVoice.pauseResume",
        "key": "alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "alishaVoice.stop",
        "key": "alt+s",
        "mac": "cmd+alt+s"
      }
    ],
    "submenus": [
      {
        "id": "alishaVoice.submenu",
        "label": "🔊 ALISHA Voice Reader"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "alishaVoice.submenu",
          "group": "navigation@100"
        }
      ],
      "webview/context": [
        {
          "command": "alishaVoice.readSelection",
          "group": "navigation@1"
        },
        {
          "command": "alishaVoice.toggleAutoReadOnCopy",
          "group": "navigation@2"
        },
        {
          "command": "alishaVoice.readFile",
          "group": "navigation@3"
        },
        {
          "command": "alishaVoice.pauseResume",
          "group": "navigation@4"
        },
        {
          "command": "alishaVoice.stop",
          "group": "navigation@5"
        }
      ],
      "alishaVoice.submenu": [
        {
          "command": "alishaVoice.readSelection",
          "group": "1_read@1"
        },
        {
          "command": "alishaVoice.toggleAutoReadOnCopy",
          "group": "1_read@1.2"
        },
        {
          "command": "alishaVoice.readFromCursor",
          "group": "1_read@1.5"
        },
        {
          "command": "alishaVoice.readFile",
          "group": "1_read@2"
        },
        {
          "command": "alishaVoice.pauseResume",
          "group": "2_controls@1"
        },
        {
          "command": "alishaVoice.stop",
          "group": "2_controls@2"
        },
        {
          "command": "alishaVoice.toggleVoice",
          "group": "3_settings@1"
        },
        {
          "command": "alishaVoice.toggleAlienPet",
          "group": "3_settings@2"
        },
        {
          "command": "alishaVoice.setSpeed",
          "group": "3_settings@3"
        }
      ],
      "explorer/context": [
        {
          "command": "alishaVoice.readFile",
          "group": "navigation@100",
          "when": "resourceExtname =~ /\\.(txt|md|pdf|markdown)$/i"
        }
      ],
      "editor/title": [
        {
          "command": "alishaVoice.readFile",
          "group": "navigation",
          "when": "resourceExtname =~ /\\.(txt|md|pdf|markdown)$/i"
        }
      ]
    },
    "configuration": {
      "title": "ALISHA - DOCS Reader",
      "properties": {
        "alishaVoice.gender": {
          "type": "string",
          "enum": [
            "female",
            "male"
          ],
          "default": "female",
          "description": "Default offline neural voice (Female: Amy, Male: Ryan)."
        },
        "alishaVoice.speed": {
          "type": "number",
          "default": 1.0,
          "minimum": 0.5,
          "maximum": 2.0,
          "description": "Playback speech rate multiplier."
        },
        "alishaVoice.highlightActiveText": {
          "type": "boolean",
          "default": true,
          "description": "Highlight sentences in the active editor in real-time as they are read."
        },
        "alishaVoice.skipCodeBlocksInMarkdown": {
          "type": "boolean",
          "default": true,
          "description": "Skip reading raw code blocks in Markdown files."
        },
        "alishaVoice.customPiperPath": {
          "type": "string",
          "default": "",
          "description": "Optional custom path to local Piper executable if not using bundled binary."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository --baseImagesUrl https://raw.githubusercontent.com/Dragonwinner/Read-Aloud-Offline-Text-to-Speech-TTS-PDF-Reader/main --baseContentUrl https://github.com/Dragonwinner/Read-Aloud-Offline-Text-to-Speech-TTS-PDF-Reader/blob/main"
  },
  "dependencies": {
    "pdf-parse": "^1.1.1",
    "remove-markdown": "^0.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "ovsx": "^1.1.1",
    "typescript": "^5.3.3"
  }
}
